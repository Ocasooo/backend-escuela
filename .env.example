# =========================================================
# CONFIGURACIÓN DEL BACKEND - ESCUELA TÉCNICA EFP N° 31
# =========================================================

# Puerto del servidor (Render asigna automáticamente process.env.PORT)
PORT=4000

# URLs permitidas por CORS para el Frontend (puedes poner varias separadas por coma)
# Ej: https://tu-frontend.vercel.app,http://localhost:4321
FRONTEND_URL=http://localhost:4321

# Clave secreta para firmar y verificar tokens JWT de sesión
JWT_SECRET=tu_clave_secreta_super_segura_efp31_2024

# ---------------------------------------------------------
# CONEXIÓN A BASE DE DATOS MYSQL (Local o en la Nube)
# Si usas Railway, Aiven, Clever Cloud, Supabase, TiDB, etc.
# ---------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=ejemplo

# Opcional: SSL para conexiones seguras en la nube ('true' o 'false')
MYSQL_SSL=false

# Opcional: Si tu proveedor te da una URL completa (ej: Railway / PlanetScale):
# DATABASE_URL=mysql://usuario:contraseña@host:puerto/nombre_db
